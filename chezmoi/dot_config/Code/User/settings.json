{
  "workbench.colorTheme": "Nord",
  "workbench.iconTheme": "vs-seti",
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Droid Sans Mono', monospace",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "files.autoSave": "onFocusChange",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.initialHint": false,
  "chat.agent.enabled": false,
  "chat.defaultProvider": "claude-code",
  "chat.sendElementsToChat.enabled": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "github.copilot.chat.enabled": false,
  "claudeCode.selectedModel": "sonnet",
  "claudeCode.hideOnboarding": true,
  "claudeCode.preferredLocation": "sidebar",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": false,
  "python.analysis.typeCheckingMode": "standard",
  "git.showStatusBarSync": false,
  "git.rebaseWhenSync": false,
  "git.pullRebase": false,
  "scm.repositories.selectionMode": "single",
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",
  "gitlens.graph.minimap.enabled": false,
  "gitlens.views.commitDetails.files.compact": true,
  "gitlens.views.commitDetails.files.icon": "type",
  "gitlens.views.commitDetails.files.layout": "tree",
  "gitlens.views.commitDetails.files.threshold": 5,
  "makefile.configureOnOpen": true,
  "workbench.commandPalette.showAskInChat": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.activityBar.location": "top",
  "chat.disableAIFeatures": true,
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/bin/bash",
      "args": [
        "-l"
      ]
    }
  },
  "terminal.integrated.defaultProfile.linux": "bash",
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false
}
