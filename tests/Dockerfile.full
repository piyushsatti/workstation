FROM ubuntu:26.04

WORKDIR /opt/bootstrap
COPY . /opt/bootstrap

RUN apt-get update \
  && apt-get install --yes ca-certificates curl tar gzip

RUN bash bootstrap.sh --apply --noninteractive --no-packages \
  --destination /tmp/bootstrap-home \
  --workspace /tmp/bootstrap-home/Studio

RUN test -f /tmp/bootstrap-home/.bashrc \
  && test -f /tmp/bootstrap-home/.config/Code/User/settings.json \
  && test -f /tmp/bootstrap-home/Studio/memory/workspace-principles.md \
  && test -f /tmp/bootstrap-home/Studio/.bootstrap/context.md \
  && /tmp/bootstrap-home/.local/bin/chezmoi --version | grep -q 'v2.70.5'

RUN bash bootstrap.sh --apply --noninteractive --no-packages \
  --destination /tmp/bootstrap-home \
  --workspace /tmp/bootstrap-home/Studio
